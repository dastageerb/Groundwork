# Copy to .env. Docker Compose supplies the internal database URL.
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=
# Leave empty to generate and print a setup code on startup.
SETUP_CODE=
AUTH_MODE=local
DOCS_PATH=./sample-docs
OLLAMA_URL=http://ollama:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
SIMILARITY_THRESHOLD=0.55
TOP_K=4
AUTO_PULL_MODELS=true
# Native development only: DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/groundwork

# Company sign-in: local, oidc, or both. Callback: PUBLIC_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAIN=
OIDC_ALLOWED_TENANT=
ADMIN_EMAILS=
OIDC_ADMIN_SUBJECTS=
OIDC_LABEL=Company account
# Local identity-provider development only:
OIDC_ALLOW_HTTP=false
# Optional explicit proxy IPs/CIDRs. Leave empty unless your proxy overwrites
# forwarded headers and the API cannot be reached directly by untrusted clients.
TRUSTED_PROXIES=
CHAT_CONTEXT_TOKENS=8192
CHAT_OUTPUT_TOKENS=1200
MODEL_CONCURRENCY=2
AUDIT_RETENTION_DAYS=90
